{
  "name": "webapptemplate",
  "version": "2.3.0",
  "description": "Web App Template - advanced",
  "repository": {
    "type": "git",
    "url": "https://github.com/stupid-genius/webapptemplate"
  },
  "author": "Stupid Genius Software",
  "license": "GPL-3.0",
  "main": "app/server/index.js",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@valkey/valkey-glide": "^1.3.4",
    "apiclient": "github:stupid-genius/APIClient",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.1",
    "connect-redis": "^8.0.1",
    "cors": "^2.8.5",
    "ejs": "3.1.10",
    "express": "^5.2.1",
    "express-openid-connect": "^2.18.1",
    "express-session": "^1.18.2",
    "htmx.org": "^1.9.12",
    "ioredis": "^5.6.1",
    "log-ng": "github:stupid-genius/log-ng",
    "mongodb": "^6.16.0",
    "morgan": "^1.10.1",
    "mysql2": "^3.14.1",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "passport-local": "^1.0.0",
    "sequelize": "^6.37.7",
    "serve-favicon": "^2.5.0"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "chai": "^4.5.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.27.0",
    "karma": "^6.4.4",
    "karma-chai": "^0.1.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-esbuild": "^2.3.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "mocha": "^11.5.0",
    "mongodb-memory-server": "^10.2.3",
    "sinon": "^21.0.0"
  },
  "scripts": {
    "app": "docker compose up app --build",
    "build": "npm run clean; ./tools/build.sh",
    "clean": "rm -rf dist",
    "cleanlog": "rm *.log.gz *.log 2> /dev/null || :",
    "cluster": "npm run build; docker compose up --build; docker compose down",
    "esbuild": "esbuild",
    "karma": "karma start",
    "mocha": "mocha --require test/test.js \"test/server/**/*.js\"",
    "mongo": "docker compose up -d mongo mongo-express --build",
    "mysql": "docker compose up -d mysql phpmyadmin --build",
    "nodemon": "npx nodemon --watch dist/server dist/server/index.js",
    "package": "mkdir -p pckg; cd dist; npm pack --pack-destination='../pckg/'",
    "phpmyadmin": "docker compose up -d phpmyadmin --build",
    "start": "DBHOST=localhost DOCSHOST=localhost KEYVALHOST=localhost NODE_ENV=development ./tools/serve.sh",
    "test": "npm run mocha; npm run karma",
    "testServer": "node testServer.js"
  }
}
